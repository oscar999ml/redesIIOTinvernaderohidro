# ── Servidor ───────────────────────────────────────────────
PORT=4001                      # Puerto HTTP + WebSocket (frontend)
HOST=localhost                 # localhost para local, 0.0.0.0 para VPS

# ── Serial (solo debug local, no se usa en VPS) ───────────
SERIAL_PORT=COM3
SERIAL_BAUD=115200

# ── TCP para ESP32 (puerto interno, siempre 4002) ────────
# El ESP32 conecta a esta IP:4002
# Local: 192.168.x.x   |   VPS: IP pública del servidor

# ── Sede ───────────────────────────────────────────────────
SEDE_ID=central
SEDE_NOMBRE=Sede Central
DB_PATH=./data/sede_central.db

# ── Auth (JWT) ─────────────────────────────────────────────
JWT_SECRET=cambia_esto_en_produccion_usa_openssl_rand_hex_32
JWT_EXPIRES_IN=8h

# ── Modo ───────────────────────────────────────────────────
NODE_ENV=development           # development = auth bypass | production = JWT requerido
SIMULATE=false                 # false = hardware real | true = datos simulados
SIMULATE_NODOS=3
